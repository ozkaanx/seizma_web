---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Ecosystem from "../components/sections/Ecosystem.astro";
import DisasterTimeline from "../components/sections/DisasterTimeline.astro";
import NetworkSection from "../components/sections/NetworkSection.astro";
import CapabilitiesSection from "../components/sections/CapabilitiesSection.astro";
import EnterpriseSection from "../components/sections/EnterpriseSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout
  title="Seizma | Yeni Nesil Afet İletişim Teknolojileri"
  description="Seizma; afet öncesi, anı ve sonrasında iletişimin devam etmesini destekleyen mobil uygulama, Home Booster ve saha iletişim altyapısından oluşan teknoloji ekosistemidir."
>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <Ecosystem />
    <DisasterTimeline />
    <NetworkSection />
    <CapabilitiesSection />
    <EnterpriseSection />
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>