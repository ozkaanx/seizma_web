---
import Container from "../ui/Container.astro";

import {
  footerGroups,
} from "../../data/footer";

const currentYear =
  new Date().getFullYear();
---

<footer class="footer">
  <Container>
    <div class="footer__top">
      <div class="footer__brand">
        <a
          href="/"
          class="footer__logo"
          aria-label="Seizma ana sayfa"
        >
          seizma<span>.</span>
        </a>

        <p>
          Afet öncesi, anı ve sonrasında
          iletişimin devam etmesini hedefleyen
          yeni nesil teknoloji ekosistemi.
        </p>

        <div class="footer__network">
          <span></span>

          SYSTEM ONLINE
        </div>
      </div>

      <div class="footer__navigation">
        {
          footerGroups.map((group) => (
            <div class="footer-group">
              <h2>
                {group.title}
              </h2>

              <ul>
                {
                  group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={
                          link.external
                            ? "_blank"
                            : undefined
                        }
                        rel={
                          link.external
                            ? "noreferrer"
                            : undefined
                        }
                      >
                        {link.label}

                        {link.external && (
                          <span
                            aria-hidden="true"
                          >
                            ↗
                          </span>
                        )}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="footer__bottom">
      <p>
        © {currentYear} Seizma.
        Tüm hakları saklıdır.
      </p>

      <div class="footer__bottom-meta">
        <span>
          Türkiye
        </span>

        <span>
          PLAI NETWORK
        </span>
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer {
    position: relative;

    padding-block:
      80px 28px;

    border-top:
      1px solid var(--color-border);

    background:
      #050605;
  }

  .footer__top {
    display: grid;

    grid-template-columns:
      minmax(280px, 0.8fr)
      minmax(0, 1.2fr);

    gap:
      clamp(
        70px,
        10vw,
        150px
      );

    padding-bottom: 80px;
  }

  /*
   * BRAND
   */

  .footer__brand {
    max-width: 380px;
  }

  .footer__logo {
    display: inline-block;

    font-size: 34px;
    font-weight: 700;

    letter-spacing:
      -0.06em;
  }

  .footer__logo > span {
    color:
      var(--color-accent);
  }

  .footer__brand > p {
    margin-top: 26px;

    color:
      var(--color-text-muted);

    font-size: 14px;

    line-height: 1.7;
  }

  .footer__network {
    margin-top: 36px;

    display: flex;
    align-items: center;

    gap: 9px;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      var(--text-xs);

    letter-spacing:
      0.12em;
  }

  .footer__network > span {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background:
      var(--color-accent);

    box-shadow:
      0 0 14px
      rgba(234, 255, 0, 0.4);
  }

  /*
   * NAVIGATION
   */

  .footer__navigation {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 40px;
  }

  .footer-group h2 {
    margin-bottom: 24px;

    color:
      #65685f;

    font-family:
      var(--font-mono);

    font-size:
      var(--text-xs);

    font-weight: 500;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;
  }

  .footer-group ul {
    margin: 0;
    padding: 0;

    display: flex;
    flex-direction: column;

    gap: 15px;

    list-style: none;
  }

  .footer-group a {
    display: inline-flex;
    align-items: center;

    gap: 8px;

    color:
      var(--color-text-muted);

    font-size: 14px;

    transition:
      color
      var(--transition-default);
  }

  .footer-group a:hover {
    color:
      var(--color-text);
  }

  .footer-group a > span {
    color:
      var(--color-accent);
  }

  /*
   * BOTTOM
   */

  .footer__bottom {
    padding-top: 28px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    border-top:
      1px solid
      var(--color-border);
  }

  .footer__bottom p,
  .footer__bottom-meta {
    color:
      #565950;

    font-family:
      var(--font-mono);

    font-size: 9px;

    letter-spacing:
      0.08em;
  }

  .footer__bottom-meta {
    display: flex;
    align-items: center;

    gap: 24px;
  }

  @media (max-width: 900px) {
    .footer__top {
      grid-template-columns:
        1fr;

      gap: 70px;
    }

    .footer__brand {
      max-width: 500px;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-top: 64px;
    }

    .footer__top {
      padding-bottom: 60px;
    }

    .footer__navigation {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );

      gap:
        50px 24px;
    }

    .footer__bottom {
      align-items:
        flex-start;

      flex-direction:
        column;
    }

    .footer__bottom-meta {
      flex-wrap: wrap;

      gap: 12px 20px;
    }
  }

  @media (max-width: 420px) {
    .footer__navigation {
      grid-template-columns: 1fr;
    }
  }
</style>