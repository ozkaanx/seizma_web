---
import type { Product } from "../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const images = {
  app: {
    src: "/images/products/seizma-app.jpg",
    width: 269,
    height: 544,
    alt: "Seizma uygulamasının harita ve konum ekranı",
  },

  home: {
    src: "/images/products/home-booster.jpg",
    width: 544,
    height: 544,
    alt: "Seizma Home Booster cihazı",
  },

  infrastructure: {
    src: "/images/products/seizma-booster.jpg",
    width: 440,
    height: 466,
    alt: "Güneş panelli ve antenli Seizma Booster saha cihazı",
  },
};

const image =
  images[product.variant];
---

<article
  class:list={[
    "product-card",
    `product-card--${product.variant}`,
  ]}
>
  <div class="product-card__header">
    <span class="product-card__number">
      {product.number}
    </span>

    <span class="product-card__eyebrow">
      {product.eyebrow}
    </span>
  </div>

  <div class="product-card__body">
    <div class="product-card__content">
      <h3>
        {product.name}
      </h3>

      <p>
        {product.description}
      </p>

      <ul
        class="product-card__features"
        role="list"
      >
        {
          product.features.map(
            (feature) => (
              <li>
                {feature.label}
              </li>
            ),
          )
        }
      </ul>
    </div>

    <div class="product-card__visual">
      <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</article>

<style>
  .product-card {
    min-width: 0;

    padding:
      clamp(
        22px,
        3vw,
        34px
      );

    border:
      1px solid
      var(--color-border);

    border-radius:
      var(--radius-lg);

    background: #0d0e0c;
  }

  /*
   * HEADER
   */

  .product-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 16px;

    padding-bottom: 16px;

    border-bottom:
      1px solid
      var(--color-border);
  }

  .product-card__number {
    color:
      var(--color-accent);

    font-family:
      var(--font-mono);

    font-size: 10px;

    font-weight: 700;

    letter-spacing:
      0.1em;
  }

  .product-card__eyebrow {
    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size: 9px;

    font-weight: 600;

    letter-spacing:
      0.1em;

    text-transform:
      uppercase;
  }

  /*
   * BODY
   */

  .product-card__body {
    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(220px, 0.8fr);

    align-items: center;

    gap:
      clamp(
        24px,
        4vw,
        48px
      );

    padding-top: 20px;
  }

  /*
   * CONTENT
   */

  .product-card__content {
    min-width: 0;

    max-width: 620px;
  }

  .product-card h3 {
    font-size:
      clamp(
        30px,
        3.6vw,
        46px
      );

    font-weight: 600;

    line-height: 1.08;

    letter-spacing:
      -0.04em;
  }

  .product-card__content > p {
    max-width: 560px;

    margin-top: 16px;

    color:
      var(--color-text-muted);

    font-size: 14px;

    line-height: 1.7;
  }

  /*
   * FEATURES
   */

  .product-card__features {
    display: flex;
    flex-wrap: wrap;

    gap: 7px;

    margin:
      20px 0 0;

    padding: 0;

    list-style: none;
  }

  .product-card__features li {
    display: flex;
    align-items: center;

    gap: 7px;

    padding:
      8px 10px;

    border:
      1px solid
      var(--color-border);

    border-radius: 100px;

    color:
      var(--color-text-muted);

    font-size: 9px;

    font-weight: 600;

    line-height: 1.3;

    letter-spacing:
      0.045em;
  }

  .product-card__features li::before {
    content: "";

    width: 4px;
    height: 4px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--color-accent);
  }

  /*
   * VISUAL
   */

  .product-card__visual {
    min-width: 0;

    height: 270px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card__visual img {
    display: block;

    width: 100%;
    height: 100%;

    max-width: 280px;

    object-fit: contain;

    mix-blend-mode: screen;
  }

  .product-card--app
    .product-card__visual img {
    max-width: 138px;
  }

  /*
   * TABLET
   */

  @media (
    max-width: 820px
  ) {
    .product-card__body {
      grid-template-columns:
        minmax(0, 1.15fr)
        minmax(170px, 0.65fr);

      gap: 22px;
    }

    .product-card__visual {
      height: 220px;
    }

    .product-card__visual img {
      max-width: 220px;
    }

    .product-card--app
      .product-card__visual img {
      max-width: 110px;
    }
  }

  /*
   * MOBILE
   */

  @media (
    max-width: 640px
  ) {
    .product-card {
      padding:
        18px 18px 16px;

      border-radius: 16px;
    }

    .product-card__header {
      padding-bottom: 12px;
    }

    .product-card__number {
      font-size: 9px;
    }

    .product-card__eyebrow {
      max-width: 70%;

      overflow: hidden;

      font-size: 8px;

      white-space: nowrap;

      text-overflow:
        ellipsis;
    }

    .product-card__body {
      grid-template-columns:
        minmax(0, 1fr);

      gap: 14px;

      padding-top: 16px;
    }

    .product-card h3 {
      font-size: 27px;

      line-height: 1.08;
    }

    .product-card__content > p {
      margin-top: 10px;

      font-size: 13px;

      line-height: 1.58;
    }

    .product-card__features {
      gap: 6px;

      margin-top: 14px;
    }

    .product-card__features li {
      gap: 6px;

      padding:
        6px 8px;

      font-size: 8px;

      line-height: 1.25;

      letter-spacing:
        0.025em;
    }

    /*
     * Eski sürümde 220px olan
     * görsel alanını ciddi biçimde
     * küçültüyoruz.
     */

    .product-card__visual {
      height: 150px;

      margin-top: 2px;
    }

    .product-card__visual img {
      max-width: 165px;
    }

    .product-card--app
      .product-card__visual {
      height: 145px;
    }

    .product-card--app
      .product-card__visual img {
      max-width: 76px;
    }

    .product-card--infrastructure
      .product-card__visual img {
      max-width: 150px;
    }
  }

  /*
   * SMALL MOBILE
   */

  @media (
    max-width: 380px
  ) {
    .product-card {
      padding:
        16px 16px 14px;
    }

    .product-card h3 {
      font-size: 25px;
    }

    .product-card__content > p {
      font-size: 12.5px;
    }

    .product-card__visual {
      height: 135px;
    }

    .product-card__visual img {
      max-width: 145px;
    }

    .product-card--app
      .product-card__visual {
      height: 130px;
    }

    .product-card--app
      .product-card__visual img {
      max-width: 68px;
    }
  }
</style>