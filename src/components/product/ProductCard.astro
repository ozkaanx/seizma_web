---
import type { Product } from "../../data/products";

interface Props { product: Product; }
const { product } = Astro.props;
const images = {
  app: { src: "/images/products/seizma-app.jpg", width: 269, height: 544, alt: "Seizma uygulamasının harita ve konum ekranı" },
  home: { src: "/images/products/home-booster.jpg", width: 544, height: 544, alt: "Seizma Home Booster cihazı" },
  infrastructure: { src: "/images/products/seizma-booster.jpg", width: 440, height: 466, alt: "Güneş panelli ve antenli Seizma Booster saha cihazı" },
};
const image = images[product.variant];
---

<article class:list={["product-card", `product-card--${product.variant}`]}>
  <div class="product-card__header">
    <span class="product-card__number">{product.number}</span>
    <span class="product-card__eyebrow">{product.eyebrow}</span>
  </div>
  <div class="product-card__body">
    <div class="product-card__content">
      <h3>{product.name}</h3>
      <p>{product.description}</p>
      <ul class="product-card__features" role="list">
        {product.features.map((feature) => <li>{feature.label}</li>)}
      </ul>
    </div>
    <div class="product-card__visual">
      <img src={image.src} alt={image.alt} width={image.width} height={image.height}
        loading="lazy" decoding="async" />
    </div>
  </div>
</article>

<style>
  .product-card {
    min-width:0;
    padding:clamp(22px,3vw,36px);
    border:1px solid var(--color-border);
    border-radius:var(--radius-lg);
    background:#0d0e0c;
  }
  .product-card__header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding-bottom:18px;
    border-bottom:1px solid var(--color-border);
  }
  .product-card__number { color:var(--color-accent); font-size:11px; font-weight:700; letter-spacing:.1em; }
  .product-card__eyebrow { color:var(--color-text-muted); font-size:10px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; }
  .product-card__body {
    display:grid;
    grid-template-columns:minmax(0,1.2fr) minmax(240px,.8fr);
    align-items:center;
    gap:32px;
    padding-top:20px;
  }
  .product-card__content { min-width:0; max-width:620px; }
  .product-card h3 { font-size:clamp(30px,3.8vw,48px); font-weight:600; line-height:1.1; letter-spacing:-.04em; }
  .product-card__content > p { max-width:560px; margin-top:18px; font-size:15px; line-height:1.7; color:var(--color-text-muted); }
  .product-card__features { display:flex; flex-wrap:wrap; margin:22px 0 0; padding:0; gap:8px; list-style:none; }
  .product-card__features li { display:flex; align-items:center; gap:8px; padding:9px 12px; border:1px solid var(--color-border); border-radius:100px; color:var(--color-text-muted); font-size:10px; font-weight:600; letter-spacing:.06em; }
  .product-card__features li::before { content:""; width:4px; height:4px; flex-shrink:0; border-radius:50%; background:var(--color-accent); }
  .product-card__visual { display:flex; align-items:center; justify-content:center; min-width:0; height:300px; }
  .product-card__visual img {
    display:block;
    width:100%;
    height:100%;
    max-width:300px;
    object-fit:contain;
    /* Blend the supplied black backgrounds into the dark product card. */
    mix-blend-mode:screen;
  }
  .product-card--app .product-card__visual img { max-width:150px; }
  @media (max-width:640px) {
    .product-card { padding:22px 20px; }
    .product-card__body { grid-template-columns:minmax(0,1fr); gap:20px; padding-top:22px; }
    .product-card h3 { font-size:30px; }
    .product-card__content > p { margin-top:14px; font-size:14px; }
    .product-card__features { margin-top:18px; }
    .product-card__visual { height:220px; }
    .product-card__visual img { max-width:220px; }
    .product-card--app .product-card__visual img { max-width:110px; }
  }
</style>
