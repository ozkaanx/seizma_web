---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    "container",
    className,
  ]}
>
  <slot />
</div>

<style>
  .container {
    width: min(
      calc(100% - 48px),
      var(--container-width)
    );

    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .container {
      width: calc(100% - 32px);
    }
  }
</style>