---
interface Props {
  eyebrow: string;
  title: string;
  highlight?: string;
  description?: string;
}

const { eyebrow, title, highlight, description } = Astro.props;
---

<header class="section-header">
  <div class="section-header__main">
    <div class="section-header__eyebrow">
      <span></span>

      {eyebrow}
    </div>

    <h2>
      {title}

      {highlight && <span>{highlight}</span>}
    </h2>
  </div>

  {description && <p class="section-header__description">{description}</p>}
</header>

<style>
  .section-header {
    margin-bottom: clamp(70px, 9vw, 120px);

    display: grid;

    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(300px, 0.75fr);

    align-items: end;

    gap: 60px;
  }

  .section-header__eyebrow {
    margin-bottom: 26px;

    display: flex;
    align-items: center;

    gap: 10px;

    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: var(--text-xs);

    font-weight: 500;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .section-header__eyebrow > span {
    width: 24px;
    height: 1px;

    flex-shrink: 0;

    background: var(--color-accent);
  }

  .section-header h2 {
    max-width: 860px;

    font-size: var(--heading-lg);

    font-weight: 600;

    line-height: 0.92;

    letter-spacing: -0.065em;
  }

  .section-header h2 > span {
    display: block;

    color: var(--color-accent);
  }

  .section-header__description {
    max-width: 440px;

    color: var(--color-text-muted);

    font-size: var(--text-base);

    line-height: 1.75;
  }

  @media (max-width: 900px) {
    .section-header {
      grid-template-columns: 1fr;

      gap: 34px;
    }

    .section-header__description {
      max-width: 650px;
    }
  }

  @media (max-width: 640px) {
    .section-header {
      margin-bottom: 60px;
    }

    .section-header h2 {
      font-size: clamp(44px, 13vw, 64px);

      line-height: 0.94;

      letter-spacing: -0.06em;
    }
  }
</style>
