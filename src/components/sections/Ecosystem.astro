---
import Container from "../ui/Container.astro";
import ProductCard from "../product/ProductCard.astro";
import SectionHeader from "../ui/SectionHeader.astro";

import { products } from "../../data/products";
---

<section id="ekosistem" class="ecosystem">
  <Container>
    <SectionHeader
  eyebrow="Seizma Ekosistemi"
  title="Üç ürün."
  highlight="Bir iletişim ağı."
  description="Telefonunuzdan evinize, evinizden sahaya uzanan ortak bir iletişim yaklaşımı."
/>

    <div id="urunler" class="ecosystem__products">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </Container>
</section>

<style>
  .ecosystem {
    position: relative;

    scroll-margin-top: 76px;

    padding-block: var(--section-space);

    background: #080907;

    border-bottom: 1px solid var(--color-border);
  }

  .ecosystem__products {
    display: flex;
    flex-direction: column;

    gap: 24px;
  }

  @media (max-width: 900px) {
    .ecosystem__header {
      grid-template-columns: 1fr;

      gap: 34px;
    }
  }

  @media (max-width: 640px) {
    .ecosystem {
      padding-block: var(--section-space);
    }

    .ecosystem__header {
      margin-bottom: 60px;
    }

    .ecosystem h2 {
      font-size: clamp(48px, 15vw, 68px);
    }
  }

.ecosystem__products { display:grid; grid-template-columns:minmax(0,1fr); gap:20px; }
@media (max-width:900px) { .ecosystem__products { grid-template-columns:1fr; } }

</style>
