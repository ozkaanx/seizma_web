---
import Container from "../ui/Container.astro";

import { disasterPhases } from "../../data/disaster-phases";
---

<section id="afet-sureci" class="timeline">
  <Container>
    <header class="timeline__header">
      <div>
        <div class="timeline__eyebrow">
          <span></span>

          Afet süreci
        </div>

        <h2 class="timeline__title">
          Afetin her

          <span> aşamasında. </span>
        </h2>
      </div>

      <p class="timeline__intro">
        Seizma yaklaşımı yalnızca afet anındaki iletişime değil; hazırlık,
        bağlantı ve afet sonrası koordinasyonun birlikte sürdürülebilmesine
        odaklanır.
      </p>
    </header>

    <ol class="timeline__list">
      {
        disasterPhases.map((phase, index) => (
          <li
            class:list={[
              "timeline-item",
              {
                "timeline-item--reverse": index % 2 === 1,
              },
            ]}
          >
            <article class="timeline-card">
              <div class="timeline-card__top">
                <span class="timeline-card__phase">{phase.eyebrow}</span>

                <span class="timeline-card__status">PHASE {phase.number}</span>
              </div>

              <h3>{phase.title}</h3>

              <p class="timeline-card__description">{phase.description}</p>

              <ul class="timeline-card__features">
                {phase.features.map((feature) => (
                  <li>
                    <span />

                    {feature}
                  </li>
                ))}
              </ul>
            </article>

            <div class="timeline-item__axis" aria-hidden="true">
              <div class="timeline-item__node">
                <span />
              </div>
            </div>

            <div class="timeline-item__number" aria-hidden="true">
              {phase.number}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="timeline__footer">
      <div class="timeline__footer-status">
        <span></span>

        SEIZMA NETWORK
      </div>

      <p>
        Hazırlık.
        <span>Bağlantı.</span>
        Koordinasyon.
      </p>
    </div>
  </Container>
</section>

<style>
  .timeline {
    position: relative;

    padding-block: var(--section-space);

    border-bottom: 1px solid var(--color-border);

    background: linear-gradient(to bottom, #080907, #050605);

    overflow: hidden;
  }

  /*
   * HEADER
   */

  .timeline__header {
    margin-bottom: clamp(100px, 12vw, 170px);

    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(300px, 0.8fr);

    align-items: end;

    gap: 60px;
  }

  .timeline__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 26px;

    color: var(--color-text-muted);

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 0.16em;

    text-transform: uppercase;
  }

  .timeline__eyebrow > span {
    width: 24px;
    height: 1px;

    background: var(--color-accent);
  }

  .timeline__title {
    max-width: 850px;

    font-size: clamp(54px, 6.2vw, 96px);

    font-weight: 600;

    line-height: 0.92;

    letter-spacing: -0.07em;
  }

  .timeline__title span {
    display: block;

    color: var(--color-accent);
  }

  .timeline__intro {
    max-width: 430px;

    color: var(--color-text-muted);

    font-size: 16px;

    line-height: 1.75;
  }

  /*
   * TIMELINE
   */

  .timeline__list {
    position: relative;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  /*
   * Ortadaki ana bağlantı hattı.
   */
  .timeline__list::before {
    content: "";

    position: absolute;

    top: 0;
    bottom: 0;
    left: 50%;

    width: 1px;

    background: linear-gradient(
      to bottom,
      transparent,
      rgba(234, 255, 0, 0.25) 10%,
      rgba(234, 255, 0, 0.25) 90%,
      transparent
    );

    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;

    min-height: 470px;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      120px
      minmax(0, 1fr);

    align-items: center;
  }

  /*
   * CARD
   */

  .timeline-card {
    position: relative;

    z-index: 2;

    grid-column: 1;

    width: min(100%, 520px);

    justify-self: end;

    margin-right: 45px;

    padding: clamp(28px, 4vw, 44px);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    background: rgba(13, 14, 12, 0.82);

    backdrop-filter: blur(16px);

    transition:
      border-color var(--transition-default),
      transform var(--transition-default),
      background var(--transition-default);
  }

  /*
   * Karttan merkeze giden küçük çizgi.
   */
  .timeline-card::after {
    content: "";

    position: absolute;

    top: 50%;
    right: -46px;

    width: 46px;
    height: 1px;

    background: linear-gradient(
      to right,
      var(--color-border),
      rgba(234, 255, 0, 0.45)
    );
  }

  .timeline-card:hover {
    border-color: rgba(234, 255, 0, 0.22);

    background: rgba(16, 17, 14, 0.94);

    transform: translateY(-4px);
  }

  /*
   * İkinci kart sağa geçiyor.
   */

  .timeline-item--reverse .timeline-card {
    grid-column: 3;

    justify-self: start;

    margin-right: 0;
    margin-left: 45px;
  }

  .timeline-item--reverse .timeline-card::after {
    right: auto;
    left: -46px;

    background: linear-gradient(
      to left,
      var(--color-border),
      rgba(234, 255, 0, 0.45)
    );
  }

  .timeline-card__top {
    margin-bottom: 55px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }

  .timeline-card__phase {
    color: var(--color-accent);

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 0.14em;

    text-transform: uppercase;
  }

  .timeline-card__status {
    padding: 7px 10px;

    border: 1px solid var(--color-border);

    border-radius: 100px;

    color: #666960;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 0.14em;
  }

  .timeline-card h3 {
    max-width: 430px;

    font-size: clamp(44px, 4vw, 64px);

    font-weight: 600;

    line-height: 0.95;

    letter-spacing: -0.06em;
  }

  .timeline-card__description {
    max-width: 450px;

    margin-top: 26px;

    color: var(--color-text-muted);

    font-size: 15px;

    line-height: 1.7;
  }

  .timeline-card__features {
    margin: 34px 0 0;

    padding: 0;

    display: flex;
    flex-wrap: wrap;

    gap: 9px;

    list-style: none;
  }

  .timeline-card__features li {
    display: flex;
    align-items: center;
    gap: 8px;

    padding: 9px 12px;

    border: 1px solid var(--color-border);

    border-radius: 100px;

    color: #8c8f87;

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }

  .timeline-card__features li > span {
    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: var(--color-accent);
  }

  /*
   * CENTER AXIS
   */

  .timeline-item__axis {
    position: relative;

    z-index: 3;

    grid-column: 2;
    grid-row: 1;

    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-item__node {
    position: relative;

    width: 28px;
    height: 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(234, 255, 0, 0.4);

    border-radius: 50%;

    background: var(--color-background);

    box-shadow:
      0 0 0 8px rgba(234, 255, 0, 0.035),
      0 0 30px rgba(234, 255, 0, 0.12);
  }

  .timeline-item__node > span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--color-accent);
  }

  /*
   * Node çevresindeki halka.
   */

  .timeline-item__node::before {
    content: "";

    position: absolute;

    inset: -18px;

    border: 1px solid rgba(234, 255, 0, 0.07);

    border-radius: 50%;
  }

  /*
   * LARGE NUMBER
   */

  .timeline-item__number {
    grid-column: 3;

    justify-self: start;

    margin-left: 55px;

    color: rgba(255, 255, 255, 0.025);

    font-size: clamp(120px, 15vw, 230px);

    font-weight: 700;

    line-height: 0.75;

    letter-spacing: -0.08em;

    user-select: none;
  }

  .timeline-item--reverse .timeline-item__number {
    grid-column: 1;

    justify-self: end;

    margin-right: 55px;
    margin-left: 0;
  }

  /*
   * FOOTER
   */

  .timeline__footer {
    margin-top: clamp(90px, 10vw, 140px);

    padding-top: 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    border-top: 1px solid var(--color-border);
  }

  .timeline__footer-status {
    display: flex;
    align-items: center;
    gap: 10px;

    color: #72756d;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 0.15em;
  }

  .timeline__footer-status > span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--color-accent);

    box-shadow: 0 0 16px rgba(234, 255, 0, 0.4);
  }

  .timeline__footer > p {
    color: var(--color-text-muted);

    font-size: clamp(18px, 2vw, 26px);

    font-weight: 500;

    letter-spacing: -0.03em;
  }

  .timeline__footer > p span {
    color: var(--color-accent);
  }

  /*
   * TABLET / MOBILE
   */

  @media (max-width: 900px) {
    .timeline__header {
      grid-template-columns: 1fr;

      gap: 34px;
    }

    .timeline__intro {
      max-width: 650px;
    }

    /*
     * Orta çizgiyi sola taşıyoruz.
     */
    .timeline__list::before {
      left: 18px;

      transform: none;
    }

    .timeline-item {
      min-height: auto;

      grid-template-columns:
        38px
        minmax(0, 1fr);

      padding-block: var(--section-space);
    }

    .timeline-card,
    .timeline-item--reverse .timeline-card {
      grid-column: 2;

      width: 100%;

      justify-self: stretch;

      margin: 0;
    }

    .timeline-card::after,
    .timeline-item--reverse .timeline-card::after {
      display: none;
    }

    .timeline-item__axis {
      grid-column: 1;

      justify-content: flex-start;
    }

    .timeline-item__node {
      width: 20px;
      height: 20px;
    }

    .timeline-item__node > span {
      width: 5px;
      height: 5px;
    }

    .timeline-item__number {
      display: none;
    }
  }

@media (max-width: 640px) {
  .timeline-item {
    grid-template-columns:
      26px
      minmax(0, 1fr);

    column-gap: 14px;
  }

  .timeline__list::before {
    left: 10px;
  }

  .timeline-item__node {
    width: 20px;
    height: 20px;
  }

  .timeline-card {
    border-radius:
      var(--radius-md);

    padding:
      26px 20px;
  }

  .timeline-card__features {
    gap: 7px;
  }
}

  @media (prefers-reduced-motion: reduce) {
    .timeline-card {
      transition: none;
    }
  }
</style>
