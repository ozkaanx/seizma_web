---
import Container from "../ui/Container.astro";
import { disasterPhases } from "../../data/disaster-phases";
---

<section id="afet-sureci" class="timeline" aria-labelledby="timeline-title">
  <Container>
    <header class="timeline__header">
      <div>
        <p class="timeline__eyebrow">Afet süreci</p>
        <h2 id="timeline-title">Afetin her <span>aşamasında.</span></h2>
      </div>
      <p class="timeline__intro">
        Hazırlık, bağlantı ve koordinasyon. Seizma, afet sürecini
        birbirini tamamlayan üç aşamada ele alır.
      </p>
    </header>

    <ol class="timeline__list" role="list">
      {disasterPhases.map((phase) => (
        <li class="timeline-item">
          <div class="timeline-item__step" aria-hidden="true">
            <span>{phase.number}</span>
          </div>
          <article class="timeline-card">
            <p class="timeline-card__phase">{phase.eyebrow}</p>
            <h3>{phase.title}</h3>
            <p class="timeline-card__description">{phase.description}</p>
            <ul class="timeline-card__features" role="list">
              {phase.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .timeline {
    padding-block: clamp(48px, 6vw, 80px);
    scroll-margin-top: 96px;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, #080907, #0b0d09);
  }
  .timeline__header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    align-items: end;
    gap: 24px;
    margin-bottom: 32px;
  }
  .timeline__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .timeline__eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }
  .timeline h2 {
    margin: 0;
    font-size: clamp(32px, 4.3vw, 54px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -.045em;
  }
  .timeline h2 span { color: var(--color-accent); }
  .timeline__intro {
    max-width: 440px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .timeline__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline-item { display: flex; flex-direction: column; min-width: 0; }
  .timeline-item__step {
    position: relative;
    display: flex;
    align-items: center;
    height: 36px;
    margin-bottom: 14px;
  }
  .timeline-item:not(:last-child) .timeline-item__step::after {
    content: "";
    position: absolute;
    left: 48px;
    right: -6px;
    height: 1px;
    background: linear-gradient(90deg, rgba(234,255,0,.35), var(--color-border));
  }
  .timeline-item__step span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(234,255,0,.25);
    border-radius: 50%;
    background: #14170c;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .timeline-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: #11130f;
  }
  .timeline-card__phase {
    margin: 0 0 12px;
    color: var(--color-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .timeline-card h3 {
    margin: 0;
    font-size: clamp(22px, 2.3vw, 28px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.035em;
  }
  .timeline-card__description {
    margin: 14px 0 20px;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.7;
  }
  .timeline-card__features {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }
  .timeline-card__features li {
    padding: 6px 9px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 6px;
    color: #b5b9ac;
    font-size: 11px;
    line-height: 1.4;
  }
  @media (max-width: 900px) {
    .timeline__header { grid-template-columns: 1fr; gap: 16px; margin-bottom: 24px; }
    .timeline__intro { max-width: 600px; }
    .timeline__list { grid-template-columns: 1fr; gap: 14px; }
    .timeline-item { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 12px; }
    .timeline-item__step { height: 100%; margin-bottom: 0; align-items: start; }
    .timeline-item__step span { width: 32px; height: 32px; margin-top: 20px; }
    .timeline-item:not(:last-child) .timeline-item__step::after {
      left: 15px; right: auto; top: 60px; bottom: -26px;
      width: 1px; height: auto;
      background: linear-gradient(180deg, rgba(234,255,0,.3), var(--color-border));
    }
    .timeline-card { padding: 20px; border-radius: 14px; }
    .timeline-card__description { margin: 12px 0 16px; }
  }
  @media (max-width: 380px) {
    .timeline-item { column-gap: 8px; }
    .timeline-card { padding: 16px; }
  }
</style>
