---
import Container from "../ui/Container.astro";

import { infrastructureItems } from "../../data/infrastructure";
---

<section id="teknoloji" class="problem">
  <Container>
    <div class="problem__layout">
      <div class="problem__intro">
        <div class="problem__sticky">
          <div class="problem__eyebrow">
            <span></span>

            Kritik altyapı
          </div>

          <h2 class="problem__title">
            İletişim

            <span> kesilmek zorunda değil. </span>
          </h2>

          <p class="problem__description">
            Afet anında günlük iletişimi mümkün kılan sistemler aynı anda
            etkilenebilir. Seizma'nın yaklaşımı, iletişimi yalnızca tek bir
            altyapıya bağımlı bırakmamak üzerine kuruludur.
          </p>

          <div class="problem__indicator">
            <span class="problem__indicator-dot"></span>

            Alternatif iletişim altyapısı
          </div>
        </div>
      </div>

      <div class="problem__items">
        {
          infrastructureItems.map((item) => (
            <article class="problem-card">
              <div class="problem-card__header">
                <span class="problem-card__number">{item.number}</span>

                <span class="problem-card__state">CRITICAL</span>
              </div>

              <div class="problem-card__content">
                <h3>{item.title}</h3>

                <p class="problem-card__status">{item.status}</p>

                <p class="problem-card__description">{item.description}</p>
              </div>

              <div class="problem-card__visual" aria-hidden="true">
                <div class="signal">
                  <span />
                  <span />
                  <span />
                  <span />
                </div>

                <div class="problem-card__offline">OFFLINE</div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .problem {
    position: relative;

    padding-block: var(--section-space);

    border-bottom: 1px solid var(--color-border);

    background: linear-gradient(to bottom, #070807, #0a0b09);
  }

  .problem__layout {
    display: grid;

    grid-template-columns:
      minmax(0, 0.82fr)
      minmax(440px, 1.18fr);

    gap: clamp(70px, 10vw, 160px);
  }

  /*
   * LEFT
   */

  .problem__sticky {
    position: sticky;

    top: 140px;
  }

  .problem__intro {
    position: relative;

    align-self: stretch;
  }

  .problem__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 28px;

    color: var(--color-text-muted);

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 0.16em;

    text-transform: uppercase;
  }

  .problem__eyebrow > span {
    width: 24px;
    height: 1px;

    background: var(--color-accent);
  }

  .problem__title {
    max-width: 650px;

    font-size: clamp(48px, 5.5vw, 86px);

    font-weight: 600;

    line-height: 0.94;

    letter-spacing: -0.065em;
  }

  .problem__title > span {
    display: block;

    color: var(--color-text-muted);
  }

  .problem__description {
    max-width: 500px;

    margin-top: 36px;

    color: var(--color-text-muted);

    font-size: clamp(16px, 1.4vw, 19px);

    line-height: 1.7;
  }

  .problem__indicator {
    margin-top: 48px;

    display: flex;
    align-items: center;
    gap: 10px;

    color: #74776f;

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .problem__indicator-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--color-accent);

    box-shadow: 0 0 14px rgba(234, 255, 0, 0.45);
  }

  /*
   * RIGHT
   */

  .problem__items {
    display: flex;
    flex-direction: column;
  }

  .problem-card {
    position: relative;

    min-height: 430px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: clamp(28px, 4vw, 48px);

    border-top: 1px solid var(--color-border);

    overflow: hidden;
  }

  .problem-card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .problem-card::before {
    content: "";

    position: absolute;

    top: 0;
    right: 0;

    width: 1px;
    height: 100%;

    background: linear-gradient(
      to bottom,
      transparent,
      rgba(234, 255, 0, 0.35),
      transparent
    );

    opacity: 0;

    transition: opacity var(--transition-default);
  }

  .problem-card:hover::before {
    opacity: 1;
  }

  .problem-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .problem-card__number {
    color: var(--color-accent);

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 0.12em;
  }

  .problem-card__state {
    padding: 7px 10px;

    border: 1px solid rgba(255, 255, 255, 0.08);

    border-radius: 100px;

    color: #666960;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 0.16em;
  }

  .problem-card__content {
    position: relative;

    z-index: 2;

    max-width: 480px;

    margin-top: 80px;
  }

  .problem-card h3 {
    color: var(--color-text-muted);

    font-size: 14px;
    font-weight: 600;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .problem-card__status {
    margin-top: 8px;

    color: var(--color-text);

    font-size: clamp(42px, 5vw, 72px);

    font-weight: 600;

    line-height: 1;

    letter-spacing: -0.06em;
  }

  .problem-card__description {
    max-width: 460px;

    margin-top: 25px;

    color: #767970;

    font-size: 15px;

    line-height: 1.65;
  }

  /*
   * SIGNAL VISUAL
   */

  .problem-card__visual {
    position: absolute;

    right: 36px;
    bottom: 36px;

    width: 150px;
    height: 150px;

    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0.22;

    transition: opacity var(--transition-default);
  }

  .problem-card:hover .problem-card__visual {
    opacity: 0.55;
  }

  .signal {
    position: relative;

    width: 110px;
    height: 110px;
  }

  .signal span {
    position: absolute;

    bottom: 0;

    width: 15px;

    border-radius: 3px 3px 0 0;

    background: var(--color-text);
  }

  .signal span:nth-child(1) {
    left: 0;

    height: 25%;
  }

  .signal span:nth-child(2) {
    left: 30px;

    height: 45%;
  }

  .signal span:nth-child(3) {
    left: 60px;

    height: 70%;
  }

  .signal span:nth-child(4) {
    left: 90px;

    height: 100%;
  }

  .signal::after {
    content: "";

    position: absolute;

    top: 47%;
    left: -10%;

    width: 125%;
    height: 2px;

    background: var(--color-accent);

    transform: rotate(-45deg);
  }

  .problem-card__offline {
    position: absolute;

    right: 0;
    bottom: -24px;

    color: var(--color-accent);

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 0.15em;
  }

  /*
   * RESPONSIVE
   */

  @media (max-width: 900px) {
    .problem__layout {
      grid-template-columns: 1fr;

      gap: 80px;
    }

    .problem__sticky {
      position: static;
    }

    .problem__description {
      max-width: 650px;
    }

    .problem-card {
      min-height: 360px;
    }
  }

  @media (max-width: 640px) {
    .problem__layout {
      gap: 64px;
    }

    .problem__title {
      font-size: clamp(48px, 15vw, 68px);
    }

    .problem__description {
      margin-top: 28px;

      font-size: 16px;
    }

    .problem__indicator {
      margin-top: 36px;
    }

    .problem-card {
      min-height: 380px;

      padding: 28px 0;
    }

    .problem-card__content {
      margin-top: 70px;
    }

    .problem-card__status {
      font-size: clamp(46px, 14vw, 64px);
    }

    .problem-card__description {
      max-width: 80%;
    }

    .problem-card__visual {
      right: 0;
      bottom: 35px;

      width: 100px;
      height: 100px;

      transform: scale(0.7);
    }
  }
</style>
