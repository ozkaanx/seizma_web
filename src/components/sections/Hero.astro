---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section class="hero">
  <div
    class="hero__grid"
    aria-hidden="true"
  ></div>

  <div
    class="hero__glow"
    aria-hidden="true"
  ></div>

  <Container>
    <div class="hero__layout">
      <div class="hero__content">
        <div class="hero__eyebrow">
          <span class="hero__status-dot"></span>

          Yeni nesil afet iletişim teknolojisi
        </div>

        <h1 class="hero__title">
          Afetlere karşı

          <span>
            bağlantıyı
          </span>

          kesmeyin.
        </h1>

        <p class="hero__description">
          Mobil uygulama, ev cihazı ve saha altyapısıyla
          afet koşullarında alternatif iletişim sağlamayı
          hedefleyen bir ağ.
        </p>

        <div class="hero__actions">
          <Button href="#urunler">
            Ürünleri Keşfet
          </Button>

          <Button
            href="#nasil-calisir"
            variant="secondary"
          >
            Nasıl Çalışır?
          </Button>
        </div>

        <div class="hero__meta">
          <div class="hero__meta-item">
            <span></span>
            PLAI Network
          </div>

          <div class="hero__meta-item">
            <span></span>
            Offline Ready
          </div>

          <div class="hero__meta-item">
            <span></span>
            Afet İletişimi
          </div>
        </div>
      </div>

      <div
        class="hero__visual"
        aria-hidden="true"
      >
        <div class="network">
          <svg
            class="network__lines"
            viewBox="0 0 600 600"
            fill="none"
          >
            <path d="M105 355L221 240L345 300L466 176"></path>

            <path d="M221 240L274 430"></path>

            <path d="M345 300L462 411"></path>

            <path d="M466 176L521 293"></path>
          </svg>

          <div class="network__node network__node--1">
            <span></span>
          </div>

          <div class="network__node network__node--2">
            <span></span>
          </div>

          <div
            class="network__node network__node--3 network__node--main"
          >
            <span></span>

            <div class="network__label">
              SEIZMA
            </div>
          </div>

          <div class="network__node network__node--4">
            <span></span>
          </div>

          <div class="network__node network__node--5">
            <span></span>
          </div>

          <div class="network__node network__node--6">
            <span></span>
          </div>

          <div class="network__pulse network__pulse--1"></div>

          <div class="network__pulse network__pulse--2"></div>

          <div class="network__info network__info--top">
            <span>01</span>

            ACTIVE NODE
          </div>

          <div class="network__info network__info--bottom">
            PLAI NETWORK

            <span>
              CONNECTED
            </span>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <div class="hero__bottom-line"></div>
</section>

<style>
  .hero {
    position: relative;

    min-height: 100svh;

    display: flex;
    align-items: center;

    padding-top: 76px;

    overflow: hidden;

    isolation: isolate;
  }

  .hero__layout {
    position: relative;
    z-index: 2;

    min-height:
      calc(100svh - 76px);

    display: grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(320px, 0.9fr);

    align-items: center;

    gap:
      clamp(
        32px,
        5vw,
        80px
      );

    padding-block:
      clamp(
        70px,
        8vw,
        110px
      )
      60px;
  }

  /*
   * BACKGROUND
   */

  .hero__grid {
    position: absolute;
    z-index: -3;

    inset: 0;

    background-image:
      linear-gradient(
        rgba(
          255,
          255,
          255,
          0.035
        )
        1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(
          255,
          255,
          255,
          0.035
        )
        1px,
        transparent 1px
      );

    background-size:
      64px 64px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 92%
      );
  }

  .hero__glow {
    position: absolute;
    z-index: -2;

    top: 10%;
    right: -15%;

    width: 700px;
    height: 700px;

    border-radius: 50%;

    background:
      rgba(
        234,
        255,
        0,
        0.08
      );

    filter:
      blur(150px);

    pointer-events: none;
  }

  /*
   * CONTENT
   */

  .hero__content {
    position: relative;
    z-index: 3;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 24px;

    color:
      var(--color-text-muted);

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 0.15em;

    text-transform: uppercase;
  }

  .hero__status-dot {
    position: relative;

    width: 7px;
    height: 7px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--color-accent);

    box-shadow:
      0 0 0 4px
      rgba(
        234,
        255,
        0,
        0.1
      );
  }

  .hero__status-dot::after {
    content: "";

    position: absolute;

    inset: -5px;

    border:
      1px solid
      rgba(
        234,
        255,
        0,
        0.3
      );

    border-radius: 50%;

    animation:
      status-pulse
      2.4s
      ease-out
      infinite;
  }

  .hero__title {
    max-width: 760px;

    font-size:
      clamp(
        58px,
        6.6vw,
        108px
      );

    font-weight: 600;

    line-height: 0.88;

    letter-spacing:
      -0.07em;

    text-wrap: balance;
  }

  .hero__title span {
    display: block;

    color:
      var(--color-accent);
  }

  .hero__description {
    max-width: 560px;

    margin-top: 32px;

    color:
      var(--color-text-muted);

    font-size:
      clamp(
        16px,
        1.4vw,
        19px
      );

    line-height: 1.65;
  }

  .hero__actions {
    margin-top: 32px;

    display: flex;
    flex-wrap: wrap;

    gap: 12px;
  }

  .hero__meta {
    margin-top: 52px;

    display: flex;
    flex-wrap: wrap;

    gap: 24px;
  }

  .hero__meta-item {
    display: flex;
    align-items: center;

    gap: 9px;

    color: #777b72;

    font-size: 9px;
    font-weight: 700;

    letter-spacing:
      0.12em;

    text-transform: uppercase;
  }

  .hero__meta-item > span {
    width: 4px;
    height: 4px;

    border-radius: 50%;

    background:
      var(--color-accent);
  }

  /*
   * NETWORK
   */

  .hero__visual {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    min-width: 0;
  }

  .network {
    position: relative;

    width:
      min(
        100%,
        560px
      );

    aspect-ratio: 1;

    border:
      1px solid
      var(--color-border);

    border-radius: 50%;

    background:
      radial-gradient(
        circle at center,
        rgba(
          234,
          255,
          0,
          0.045
        ),
        transparent 55%
      );

    box-shadow:
      inset
      0 0 100px
      rgba(
        255,
        255,
        255,
        0.018
      );
  }

  .network::before,
  .network::after {
    content: "";

    position: absolute;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.055
      );

    border-radius: 50%;
  }

  .network::before {
    inset: 12%;
  }

  .network::after {
    inset: 28%;
  }

  .network__lines {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
  }

  .network__lines path {
    stroke:
      rgba(
        234,
        255,
        0,
        0.27
      );

    stroke-width: 1;

    stroke-dasharray:
      5 8;

    animation:
      network-flow
      18s
      linear
      infinite;
  }

  .network__node {
    position: absolute;

    width: 28px;
    height: 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    border:
      1px solid
      rgba(
        234,
        255,
        0,
        0.25
      );

    border-radius: 50%;

    background: #0b0c0a;

    box-shadow:
      0 0 20px
      rgba(
        234,
        255,
        0,
        0.08
      );
  }

  .network__node > span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background:
      var(--color-accent);
  }

  .network__node--1 {
    top: 56%;
    left: 15%;
  }

  .network__node--2 {
    top: 38%;
    left: 36%;
  }

  .network__node--3 {
    top: 48%;
    left: 56%;
  }

  .network__node--4 {
    top: 27%;
    left: 76%;
  }

  .network__node--5 {
    top: 69%;
    left: 45%;
  }

  .network__node--6 {
    top: 67%;
    left: 76%;
  }

  .network__node--main {
    width: 44px;
    height: 44px;

    border-color:
      rgba(
        234,
        255,
        0,
        0.5
      );

    box-shadow:
      0 0 50px
      rgba(
        234,
        255,
        0,
        0.18
      );
  }

  .network__node--main > span {
    width: 10px;
    height: 10px;
  }

  .network__label {
    position: absolute;

    top:
      calc(
        100% + 12px
      );

    left: 50%;

    color:
      var(--color-text);

    font-size: 9px;
    font-weight: 800;

    letter-spacing:
      0.16em;

    transform:
      translateX(-50%);
  }

  .network__pulse {
    position: absolute;

    border:
      1px solid
      rgba(
        234,
        255,
        0,
        0.18
      );

    border-radius: 50%;

    animation:
      network-pulse
      4s
      ease-out
      infinite;
  }

  .network__pulse--1 {
    top: 50%;
    left: 59%;

    width: 80px;
    height: 80px;
  }

  .network__pulse--2 {
    top: 46%;
    left: 55%;

    width: 130px;
    height: 130px;

    animation-delay: 1.3s;
  }

  .network__info {
    position: absolute;

    color: #777b72;

    font-size: 9px;
    font-weight: 700;

    letter-spacing:
      0.14em;
  }

  .network__info--top {
    top: 10%;
    left: 14%;

    display: flex;
    align-items: center;

    gap: 8px;
  }

  .network__info--top span {
    color:
      var(--color-accent);
  }

  .network__info--bottom {
    right: 12%;
    bottom: 11%;

    display: flex;
    flex-direction: column;

    gap: 5px;

    text-align: right;
  }

  .network__info--bottom span {
    color:
      var(--color-accent);
  }

  .hero__bottom-line {
    position: absolute;

    right: 0;
    bottom: 0;
    left: 0;

    height: 1px;

    background:
      var(--color-border);
  }

  /*
   * ANIMATIONS
   */

  @keyframes status-pulse {
    0% {
      opacity: 0.8;

      transform:
        scale(0.7);
    }

    100% {
      opacity: 0;

      transform:
        scale(2);
    }
  }

  @keyframes network-pulse {
    0% {
      opacity: 0;

      transform:
        translate(
          -50%,
          -50%
        )
        scale(0.4);
    }

    25% {
      opacity: 1;
    }

    100% {
      opacity: 0;

      transform:
        translate(
          -50%,
          -50%
        )
        scale(1.6);
    }
  }

  @keyframes network-flow {
    to {
      stroke-dashoffset:
        -100;
    }
  }

  /*
   * TABLET
   */

  @media (
    max-width: 820px
  ) {
    .hero {
      min-height: auto;

      align-items: flex-start;

      padding-top: 68px;
    }

    .hero__layout {
      min-height: auto;

      grid-template-columns:
        minmax(0, 1fr);

      gap: 42px;

      padding:
        58px 0 54px;
    }

    .hero__content {
      max-width: 700px;
    }

    .hero__visual {
      width: 100%;

      max-width: 420px;

      justify-self: center;
    }
  }

  /*
   * MOBILE
   */

  @media (
    max-width: 640px
  ) {
    .hero__layout {
      gap: 32px;

      padding:
        42px 0 42px;
    }

    .hero__eyebrow {
      max-width: 290px;

      margin-bottom: 18px;

      font-size: 9px;

      line-height: 1.5;

      letter-spacing:
        0.1em;
    }

    .hero__title {
      max-width: 360px;

      font-size:
        clamp(
          44px,
          13vw,
          58px
        );

      line-height: 0.94;

      letter-spacing:
        -0.06em;
    }

    .hero__description {
      max-width: 340px;

      margin-top: 22px;

      font-size: 14px;

      line-height: 1.65;
    }

    .hero__actions {
      margin-top: 24px;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr);

      gap: 9px;
    }

    .hero__actions
      :global(.button) {
      width: 100%;

      min-height: 48px;
    }

    /*
     * Desktop için faydalı ama
     * mobilde ilk ekranı uzatıyor.
     */
    .hero__meta {
      display: none;
    }

    .hero__visual {
      width: 100%;

      max-width: 290px;
    }

    .network__node {
      width: 20px;
      height: 20px;
    }

    .network__node > span {
      width: 5px;
      height: 5px;
    }

    .network__node--main {
      width: 34px;
      height: 34px;
    }

    .network__node--main
      > span {
      width: 8px;
      height: 8px;
    }

    .network__label {
      top:
        calc(
          100% + 8px
        );

      font-size: 7px;
    }

    .network__info {
      font-size: 6px;
    }

    .network__pulse--1 {
      width: 55px;
      height: 55px;
    }

    .network__pulse--2 {
      width: 85px;
      height: 85px;
    }

    .hero__glow {
      top: 40%;
      right: -70%;

      width: 480px;
      height: 480px;

      opacity: 0.7;

      filter:
        blur(120px);
    }
  }

  /*
   * VERY SMALL
   */

  @media (
    max-width: 380px
  ) {
    .hero__layout {
      padding-top: 36px;
    }

    .hero__title {
      font-size:
        clamp(
          41px,
          12.5vw,
          48px
        );
    }

    .hero__visual {
      max-width: 250px;
    }
  }
</style>