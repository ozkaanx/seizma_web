---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section
  id="iletisim"
  class="final-cta"
>
  <div
    class="final-cta__grid"
    aria-hidden="true"
  ></div>

  <div
    class="final-cta__glow"
    aria-hidden="true"
  ></div>

  <Container>
    <div class="final-cta__layout">
      <div class="final-cta__eyebrow">
        <span></span>

        Hazırlık bugünden başlar
      </div>

      <h2>
        Afet gelmeden

        <span>
          hazır olun.
        </span>
      </h2>

      <p>
        Seizma ekosistemi, bireysel ve kurumsal
        iletişim ihtiyaçlarını afet koşullarına
        karşı daha dayanıklı hale getirmek üzere
        tasarlanan bütüncül bir teknoloji yaklaşımıdır.
      </p>

      <div class="final-cta__actions">
        <Button
          href="mailto:info@seizma.com"
        >
          Bizimle İletişime Geçin
        </Button>

        <Button
          href="#ekosistem"
          variant="secondary"
        >
          Ekosistemi İncele
        </Button>
      </div>

      <div class="final-cta__status">
        <span></span>

        PLAI NETWORK · READY
      </div>
    </div>
  </Container>
</section>

<style>
  .final-cta {
    position: relative;

    min-height:
      min(850px, 90svh);

    display: flex;
    align-items: center;

    padding-block:
      var(--section-space);

    background:
      #070807;

    overflow: hidden;

    isolation: isolate;
  }

  .final-cta__grid {
    position: absolute;
    inset: 0;

    z-index: -3;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      );

    background-size:
      64px 64px;

    mask-image:
      radial-gradient(
        circle at center,
        black,
        transparent 85%
      );
  }

  .final-cta__glow {
    position: absolute;

    z-index: -2;

    right: -10%;
    bottom: -35%;

    width: 700px;
    height: 700px;

    border-radius: 50%;

    background:
      rgba(234, 255, 0, 0.08);

    filter:
      blur(140px);
  }

  .final-cta__layout {
    max-width: 1050px;
  }

  .final-cta__eyebrow {
    margin-bottom: 28px;

    display: flex;
    align-items: center;

    gap: 10px;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      var(--text-xs);

    font-weight: 500;

    letter-spacing:
      0.12em;

    text-transform: uppercase;
  }

  .final-cta__eyebrow > span {
    width: 24px;
    height: 1px;

    background:
      var(--color-accent);
  }

  .final-cta h2 {
    max-width: 1000px;

    font-size:
      var(--heading-xl);

    font-weight: 600;

    line-height: 0.88;

    letter-spacing:
      -0.07em;
  }

  .final-cta h2 > span {
    display: block;

    color:
      var(--color-accent);
  }

  .final-cta p {
    max-width: 620px;

    margin-top: 36px;

    color:
      var(--color-text-muted);

    font-size:
      var(--text-lg);

    line-height: 1.7;
  }

  .final-cta__actions {
    margin-top: 42px;

    display: flex;
    flex-wrap: wrap;

    gap: 12px;
  }

  .final-cta__status {
    margin-top: 70px;

    display: flex;
    align-items: center;

    gap: 10px;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      var(--text-xs);

    letter-spacing:
      0.12em;
  }

  .final-cta__status > span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background:
      var(--color-accent);

    box-shadow:
      0 0 16px
      rgba(234, 255, 0, 0.4);
  }

  @media (max-width: 640px) {
    .final-cta {
      min-height: auto;
    }

    .final-cta h2 {
      font-size:
        clamp(
          52px,
          15vw,
          76px
        );
    }

    .final-cta p {
      font-size: 16px;
    }

    .final-cta__actions {
      display: grid;

      grid-template-columns:
        1fr;
    }

    .final-cta__actions
    :global(.button) {
      width: 100%;
    }
  }
</style>